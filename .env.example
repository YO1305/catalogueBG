# Session cookie HMAC. Required in production.
SESSION_SECRET=

# Demo accounts on the local JSON store. Set to 0 in production.
NEXT_PUBLIC_DEMO_AUTH=1

# Firebase client (browser login). Leave empty to use the local demo store.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin. All three are required before Firestore replaces data/seed.json.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Server-only. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
